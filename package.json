{
  "name": "car-dealership-software",
  "version": "0.1.0",
  "private": true,
  "description": "Dealer management platform \u2014 Phase 248 Service Cockpit v2 & Fixed Ops operations",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0 <25.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration.test.ts tests/routes.test.ts",
    "migrate": "tsx scripts/migrate.ts",
    "lint": "eslint .",
    "ratchet:check": "tsx scripts/quality-ratchet.ts check",
    "ratchet:update": "tsx scripts/quality-ratchet.ts update",
    "schema:fingerprint": "tsx scripts/schema-fingerprint.ts",
    "seed:mpi": "tsx scripts/seed-mpi-template.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.11.10",
    "eslint": "^10.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
