# Copy to .env and fill in. Never commit the real file.

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dealership
# Set to "require" when the database is reached over the public internet.
PGSSL=
PGPOOL_MAX=10
PGPOOL_IDLE_MS=30000
PGPOOL_CONNECT_MS=5000

# ── Secrets (minimum 32 characters each) ────────────────────
# Signs and verifies the bearer tokens that carry tenant and user identity.
JWT_SECRET=
# Signs short-lived step-up tokens for privileged actions (RO authorization,
# cancellation, and staff-attested customer authorizations).
STEP_UP_SECRET=

# ── Server ──────────────────────────────────────────────────
PORT=3000
LOG_LEVEL=info
JSON_BODY_LIMIT=1mb
