# Copy to .env and fill in. Never commit the real file.

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dealership
# Set to "require" when the database is reached over the public internet.
PGSSL=
PGPOOL_MAX=10
PGPOOL_IDLE_MS=30000
PGPOOL_CONNECT_MS=5000

# ── Identity (FBL-020, WorkOS AuthKit) ──────────────────────
# Leave IDENTITY_PROVIDER unset (or "disabled") for local work and CI: no WorkOS
# credential is needed to build, test or migrate. Set it to "workos" and fill in
# EVERY variable below to serve real logins. In production all four URLs must be
# https and the process refuses to start otherwise.
IDENTITY_PROVIDER=
WORKOS_CLIENT_ID=
# Minimum 32 characters.
WORKOS_API_KEY=
WORKOS_ISSUER=
WORKOS_JWKS_URI=
WORKOS_REDIRECT_URI=
# The REAUTHENTICATION callback — a DIFFERENT registered redirect from the login
# one; the max_age=0 leg returns here, not to /auth/callback.
WORKOS_REAUTH_REDIRECT_URI=
WORKOS_LOGOUT_REDIRECT_URI=
# Minimum 32 characters. Keys the session/transaction cookie sealing and the CSRF
# token derivation — rotating it invalidates live sessions.
WORKOS_COOKIE_PASSWORD=
# The audience claim this API accepts in provider access tokens.
OIDC_AUDIENCE=
# Bounded clock skew for token temporal claims, default 60, max 300.
OIDC_CLOCK_SKEW_SECONDS=

# ── Docker compose only ─────────────────────────────────────────────
# Password for the compose-managed postgres. DATABASE_URL above is ignored by
# docker compose (it constructs its own against the postgres service).
POSTGRES_PASSWORD=

# FBL-020-R7-C1 §2: password for the NON-OWNER application login (dealership_app,
# created by migration 060). The api and worker authenticate with this; the
# migration runner keeps the owner credential above. Provisioned onto the role
# by the one-shot provision-app-login compose service.
DEALERSHIP_APP_PASSWORD=

# ── Server ──────────────────────────────────────────────────
PORT=3000
LOG_LEVEL=info
JSON_BODY_LIMIT=1mb
